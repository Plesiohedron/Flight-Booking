{
  "uid": "flight-booking-services",
  "title": "Flight Booking Services",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Booking Service RPS",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum(rate(http_requests_total{job=\"booking-service\"}[1m])) by (endpoint)", "legendFormat": "{{endpoint}}"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Booking Service Error Count",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "sum(increase(http_request_errors_total{job=\"booking-service\"}[5m])) by (endpoint, error_type)", "legendFormat": "{{endpoint}} {{error_type}}"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Booking Service Latency p50/p95/p99",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"booking-service\"}[5m])) by (le, endpoint))", "legendFormat": "p50 {{endpoint}}"},
        {"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"booking-service\"}[5m])) by (le, endpoint))", "legendFormat": "p95 {{endpoint}}"},
        {"expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"booking-service\"}[5m])) by (le, endpoint))", "legendFormat": "p99 {{endpoint}}"}
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Booking Service Availability",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "100 * sum(rate(http_requests_total{job=\"booking-service\",status!~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"booking-service\"}[5m])), 0.001)", "legendFormat": "availability"}],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Flight Service gRPC RPS",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [{"expr": "sum(rate(http_requests_total{job=\"flight-service\"}[1m])) by (endpoint)", "legendFormat": "{{endpoint}}"}]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Flight Service Error Count",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [{"expr": "sum(increase(http_request_errors_total{job=\"flight-service\"}[5m])) by (endpoint, error_type)", "legendFormat": "{{endpoint}} {{error_type}}"}]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Flight Service Latency p50/p95/p99",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"flight-service\"}[5m])) by (le, endpoint))", "legendFormat": "p50 {{endpoint}}"},
        {"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"flight-service\"}[5m])) by (le, endpoint))", "legendFormat": "p95 {{endpoint}}"},
        {"expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"flight-service\"}[5m])) by (le, endpoint))", "legendFormat": "p99 {{endpoint}}"}
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Flight Service Success Rate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [{"expr": "100 * sum(rate(http_requests_total{job=\"flight-service\",status=\"OK\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"flight-service\"}[5m])), 0.001)", "legendFormat": "success rate"}],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    }
  ]
}
